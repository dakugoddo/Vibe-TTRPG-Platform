{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "TestSprite": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@testsprite/testsprite-mcp@latest"
      ],
      "enabled": true,
      "environment": {
        "API_KEY": "${TESTSPRITE_API_KEY}"
      }
    },
    "context-mode": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "context-mode"
      ],
      "enabled": true
    }
  }
}
