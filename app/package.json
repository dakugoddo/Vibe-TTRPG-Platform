{
  "name": "eternity-table",
  "private": true,
  "version": "0.2.0",
  "productName": "Eternity Table",
  "description": "Local-first virtual tabletop and knowledge base for tabletop RPG campaigns.",
  "author": "Eternity Table",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "electron:dev": "cross-env VIBE_ELECTRON_DEV_SERVER_URL=http://localhost:5173 electron .",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:icons": "node scripts/generate-desktop-icons.cjs",
    "server:build": "node scripts/build-server.cjs",
    "desktop:build": "npm run build && npm run server:build",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.18",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "i18next": "^25.8.13",
    "konva": "^10.2.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-contexify": "^6.0.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.5.0",
    "react-konva": "^19.2.2",
    "react-konva-utils": "^2.0.0",
    "react-markdown": "^10.1.0",
    "react-rnd": "^10.5.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "use-image": "^1.1.4",
    "uuid": "^13.0.0",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.29",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "local.eternity-table.app",
    "productName": "Eternity Table",
    "icon": "electron/assets/icon",
    "artifactName": "Eternity-Table-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../electron-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server/dist"
      },
      {
        "from": "../server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "src/locales",
        "to": "locales"
      },
      {
        "from": "preview-world",
        "to": "preview-world"
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "Eternity-Table-${version}-portable-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Eternity-Table-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eternity Table"
    },
    "npmRebuild": false
  }
}
